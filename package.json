{
  "name": "200daysstudent",
  "version": "0.1.0",
  "private": true,
  "description": "Браузерная 3D-игра про жизнь студента",
  "scripts": {
    "start": "node scripts/serve.cjs",
    "test": "node .preview/run-checks.cjs",
    "test:bus": "node .preview/check-bus-route.cjs",
    "test:college2": "node .preview/check-college2-browser.cjs",
    "test:driver": "node .preview/check-bus-driver.cjs",
    "prepare:driver": "node scripts/prepare-bus-driver.mjs",
    "export:driver": "node .preview/check-bus-driver.cjs --export",
    "prepare:nvp": "node scripts/prepare-nvp-teacher.mjs",
    "test:nvp": "node .preview/check-nvp110.cjs",
    "prepare:medvedev": "node scripts/prepare-medvedev.mjs",
    "test:medvedev": "node .preview/check-medvedev.cjs",
    "prepare:alexey": "node scripts/prepare-alexey.mjs",
    "prepare:student-walk": "node scripts/prepare-student-walk.mjs",
    "test:students": "node .preview/check-students108.cjs",
    "export:students": "node .preview/student-media.cjs --export",
    "preview:students": "node .preview/student-media.cjs --video",
    "prepare:sports": "node scripts/prepare-sports-courtyard.mjs",
    "test:sports": "node .preview/check-college-sports.cjs",
    "prepare:misha": "node scripts/prepare-misha.mjs",
    "test:misha": "node .preview/check-misha108.cjs",
    "export:misha": "node .preview/student-media.cjs --export --misha",
    "prepare:room212": "node scripts/prepare-room212.mjs",
    "test:room212": "node .preview/check-room212.cjs",
    "prepare:player": "node scripts/prepare-player.mjs && node scripts/fit-player-eyes.cjs && node scripts/prepare-player.mjs",
    "test:player": "node .preview/check-player.cjs",
    "export:player": "node .preview/check-player.cjs --export",
    "prepare:voices": "node scripts/prepare-voices.mjs",
    "test:voices": "node .preview/check-voices.cjs",
    "prepare:mom": "node scripts/fit-mom-eyes.cjs && node scripts/prepare-mom.mjs",
    "prepare:mom-media": "node scripts/prepare-mom-media.cjs",
    "test:mom": "node .preview/check-mom.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.1.0",
    "jsdom": "26.1.0",
    "meshoptimizer": "1.3.0",
    "playwright": "1.56.1",
    "three": "0.128.0"
  }
}
